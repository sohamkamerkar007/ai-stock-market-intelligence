# Local Windows setup uses SQLite. No database server or market-data API key is required.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./market_intelligence.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MODEL_DIR=models
CACHE_DIR=data/raw/cache
# Optional: legacy news ingestion only. Leave blank for the four-page app.
NEWSDATA_API_KEY=
REGIME_ALGORITHM=hmm
DEFAULT_HISTORY_YEARS=8
TRANSACTION_COST_BPS=10
SLIPPAGE_BPS=5

# Optional PostgreSQL/Docker configuration. Uncomment and set your own local password.
# POSTGRES_DB=market_intelligence
# POSTGRES_USER=market
# POSTGRES_PASSWORD=change-this-locally
# DATABASE_URL=postgresql+psycopg://market:change-this-locally@localhost:5432/market_intelligence
